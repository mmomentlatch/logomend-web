{
  "name": "logomend-web",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --host 127.0.0.1",
    "locales": "node scripts/generate-locales.mjs",
    "repair:pnpm": "node scripts/repair-pnpm-links.mjs",
    "prebuild": "node scripts/generate-locales.mjs",
    "build": "node ./node_modules/vite/bin/vite.js build --configLoader runner",
    "preview": "node ./node_modules/vite/bin/vite.js preview --host 127.0.0.1",
    "check": "node --check src/main.js && node --check src/i18n.js && node --check src/ads.js"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "fdir": "6.5.0",
    "picomatch": "4.0.3",
    "postcss": "8.5.6",
    "rollup": "4.65.0",
    "tinyglobby": "0.2.15",
    "vite": "7.1.12"
  }
}
